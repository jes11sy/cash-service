generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["cash_service", "references_service", "orders_service", "audit_logs", "error_logs"]
}

// ─────────────────────────────────────────
// Schema: references_service (read-only)
// ─────────────────────────────────────────

model City {
  id       Int     @id @default(autoincrement())
  name     String  @unique @db.VarChar(100)
  code     String  @unique @db.VarChar(20)
  isActive Boolean @default(true) @map("is_active")

  cashItems Cash[]

  @@schema("references_service")
  @@map("cities")
}

// ─────────────────────────────────────────
// Schema: orders_service (read-only)
// ─────────────────────────────────────────

model Order {
  id          Int       @id @default(autoincrement())
  cityId      Int       @map("city_id")
  masterId    Int?      @map("master_id")
  statusId    Int       @map("status_id")
  phone       String    @db.VarChar(20)
  clientName  String    @map("client_name") @db.VarChar(255)
  address     String    @db.VarChar(500)
  result      String?   @db.Text
  expenditure Decimal?  @db.Decimal(10, 2)
  clean       Decimal?  @db.Decimal(10, 2)
  masterChange Decimal? @map("master_change") @db.Decimal(10, 2)
  closingAt   DateTime? @map("closing_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  cashSubmission CashSubmission?

  @@schema("orders_service")
  @@map("orders")
}

/// Сдача кассы по заказам
model CashSubmission {
  id          Int       @id @default(autoincrement())
  orderId     Int       @unique @map("order_id")
  status      String    @db.VarChar(50)
  amount      Decimal   @db.Decimal(10, 2)
  receiptDoc  String?   @map("receipt_doc") @db.VarChar(500)
  submittedAt DateTime? @map("submitted_at")
  approvedBy  Int?      @map("approved_by")
  approvedAt  DateTime? @map("approved_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@schema("orders_service")
  @@map("cash_submissions")
}

// ─────────────────────────────────────────
// Schema: cash_service
// ─────────────────────────────────────────

/// Кассовые операции
model Cash {
  id             Int      @id @default(autoincrement())
  cityId         Int      @map("city_id")      /// FK на cities (references_service)
  type           String   @db.VarChar(50)      /// Тип (income/expense)
  amount         Decimal  @db.Decimal(10, 2)   /// Сумма
  nameCreate     String   @map("name_create") @db.VarChar(255) /// Кто создал
  paymentPurpose String?  @map("payment_purpose") @db.VarChar(255) /// Назначение платежа
  note           String?  @db.Text             /// Заметка
  receiptDocs    String[] @default([]) @map("receipt_docs") /// Массив чеков
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  city City @relation(fields: [cityId], references: [id])

  @@index([cityId])
  @@index([type])
  @@index([createdAt])
  @@index([cityId, createdAt])
  @@index([cityId, type])
  @@schema("cash_service")
  @@map("cash")
}

/// Начисления зарплаты операторам
model OperatorSalary {
  id            Int       @id @default(autoincrement())
  operatorId    Int       @map("operator_id")             /// FK на operators (auth_service)
  periodStart   DateTime  @map("period_start") @db.Date   /// Начало периода
  periodEnd     DateTime  @map("period_end") @db.Date     /// Конец периода
  ordersCount   Int       @default(0) @map("orders_count")    /// Количество заказов
  callsCount    Int       @default(0) @map("calls_count")     /// Количество звонков
  baseAmount    Decimal   @default(0) @map("base_amount") @db.Decimal(10, 2)    /// Базовая часть
  bonusAmount   Decimal   @default(0) @map("bonus_amount") @db.Decimal(10, 2)   /// Премия
  penaltyAmount Decimal   @default(0) @map("penalty_amount") @db.Decimal(10, 2) /// Штрафы
  totalAmount   Decimal   @default(0) @map("total_amount") @db.Decimal(10, 2)   /// Итого
  status        String    @default("draft") @db.VarChar(50) /// draft/approved/paid
  approvedBy    Int?      @map("approved_by")              /// FK на directors (auth_service)
  approvedAt    DateTime? @map("approved_at")              /// Дата подтверждения
  paidAt        DateTime? @map("paid_at")                  /// Дата выплаты
  note          String?   @db.Text                        /// Комментарий
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([operatorId, periodStart, periodEnd])
  @@index([operatorId])
  @@index([status])
  @@index([periodStart, periodEnd])
  @@index([operatorId, status])
  @@schema("cash_service")
  @@map("operator_salary")
}

// ─────────────────────────────────────────
// Schema: audit_logs
// ─────────────────────────────────────────

/// Аудит cash-service (кассовые операции)
model AuditCash {
  id        Int      @id @default(autoincrement())
  eventType String   @map("event_type") @db.VarChar(100) /// create/approve/reject
  userId    Int?     @map("user_id")                    /// ID пользователя
  role      String?  @db.VarChar(50)                   /// Роль
  login     String?  @db.VarChar(255)                  /// Логин
  ip        String   @db.VarChar(45)                   /// IP адрес
  userAgent String   @map("user_agent") @db.Text       /// User Agent
  success   Boolean                                    /// Успешно ли действие
  metadata  Json?    @db.JsonB                         /// Доп. данные (amount, type)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([eventType])
  @@index([userId])
  @@index([createdAt])
  @@index([success])
  @@index([role, createdAt])
  @@schema("audit_logs")
  @@map("audit_cash")
}

// ─────────────────────────────────────────
// Schema: error_logs
// ─────────────────────────────────────────

/// Ошибки cash-service
model ErrorCash {
  id            Int      @id @default(autoincrement())
  errorType     String   @map("error_type") @db.VarChar(255)    /// Тип ошибки
  errorMessage  String   @map("error_message") @db.Text         /// Сообщение
  stackTrace    String?  @map("stack_trace") @db.Text           /// Stack trace
  userId        Int?     @map("user_id")                        /// ID пользователя
  userRole      String?  @map("user_role") @db.VarChar(50)     /// Роль
  requestUrl    String?  @map("request_url") @db.VarChar(500)   /// URL запроса
  requestMethod String?  @map("request_method") @db.VarChar(10) /// HTTP метод
  ip            String?  @db.VarChar(45)                        /// IP адрес
  userAgent     String?  @map("user_agent") @db.Text            /// User Agent
  metadata      Json?    @db.JsonB                              /// Доп. данные
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([errorType])
  @@index([userId])
  @@index([createdAt])
  @@index([userRole, createdAt])
  @@schema("error_logs")
  @@map("error_cash")
}
